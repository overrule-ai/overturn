# --- API (apps/api) ---
DATABASE_URL=postgres://postgres:postgres@localhost:5432/overturn
PORT=4000
# Used to sign magic-link tokens and sessions (web auth). Any long random string.
AUTH_SECRET=change-me
# Resend, for magic-link email. Leave empty to print links to the API log instead.
RESEND_API_KEY=
EMAIL_FROM=Overturn <login@example.com>
# Public URL of the web app, used in magic links
WEB_URL=http://localhost:3000

# --- Model providers (replay + judge, M4+). Use cheap models in tests. ---
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=
OPENROUTER_API_KEY=
TOGETHER_API_KEY=
# Together project (proj_…): with it set, trained models get a dedicated endpoint before the gate

# --- SDK / CLI / example agent ---
OVERTURN_API_KEY=ov_live_...
OVERTURN_BASE_URL=http://localhost:4000

# --- Web (apps/web) ---
OVERTURN_API_URL=http://localhost:4000

