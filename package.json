{
  "name": "overturn-monorepo",
  "private": true,
  "version": "0.1.0",
  "license": "Apache-2.0",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --parallel",
    "test": "turbo run test",
    "setup:python": "turbo run setup",
    "typecheck": "turbo run typecheck",
    "lint": "biome check . && turbo run lint",
    "lint:fix": "biome check --write .",
    "db:migrate": "pnpm --filter @overturn-ai/api db:migrate",
    "db:generate": "pnpm --filter @overturn-ai/api db:generate",
    "bootstrap": "pnpm --filter @overturn-ai/api bootstrap",
    "quickstart:check": "bash scripts/quickstart-check.sh"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "turbo": "^2.11.8",
    "typescript": "^5.9.3",
    "overturn-cli": "workspace:*"
  }
}
