{
  "name": "@overturn/sdk",
  "version": "0.1.0",
  "description": "Overturn SDK: record agent runs, turn human corrections into regression cases, replay safely",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/overrule-ai/overturn.git",
    "directory": "packages/sdk"
  },
  "homepage": "https://github.com/overrule-ai/overturn#readme",
  "bugs": {
    "url": "https://github.com/overrule-ai/overturn/issues"
  },
  "keywords": [
    "llm",
    "agents",
    "evals",
    "regression-testing",
    "replay",
    "openai",
    "anthropic",
    "observability"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@overturn/shared": "workspace:*",
    "uuid": "^13.0.0"
  },
  "peerDependencies": {
    "@anthropic-ai/sdk": ">=0.30.0",
    "ai": ">=5.0.0",
    "openai": ">=4.0.0"
  },
  "peerDependenciesMeta": {
    "@anthropic-ai/sdk": {
      "optional": true
    },
    "ai": {
      "optional": true
    },
    "openai": {
      "optional": true
    }
  },
  "devDependencies": {
    "@ai-sdk/provider": "^2.0.5",
    "@anthropic-ai/sdk": "^0.134.0",
    "@types/node": "^22.20.5",
    "ai": "^5.0.277",
    "openai": "^5.23.2",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  }
}
