{
  "name": "@overturn-ai/shared",
  "version": "0.1.5",
  "description": "Shared schemas, types, fingerprinting and scorers for Overturn",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/overrule-ai/overturn.git",
    "directory": "packages/shared"
  },
  "homepage": "https://github.com/overrule-ai/overturn#readme",
  "bugs": {
    "url": "https://github.com/overrule-ai/overturn/issues"
  },
  "keywords": [
    "llm",
    "agents",
    "evals",
    "regression-testing",
    "replay",
    "openai",
    "anthropic",
    "observability"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./capture": {
      "types": "./dist/capture.d.ts",
      "import": "./dist/capture.js",
      "require": "./dist/capture.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "jsonpath-plus": "^10.4.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  }
}
