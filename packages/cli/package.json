{
  "name": "overturn",
  "version": "0.1.0",
  "description": "Overturn CLI: list runs and cases, replay corrections against any model, report regressions",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/overrule-ai/overturn.git",
    "directory": "packages/cli"
  },
  "homepage": "https://github.com/overrule-ai/overturn#readme",
  "bugs": {
    "url": "https://github.com/overrule-ai/overturn/issues"
  },
  "keywords": [
    "llm",
    "agents",
    "evals",
    "regression-testing",
    "replay",
    "openai",
    "anthropic",
    "observability"
  ],
  "type": "module",
  "bin": {
    "overturn": "./bin/overturn.js"
  },
  "files": [
    "dist",
    "bin"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@overturn-ai/sdk": "workspace:*",
    "@overturn-ai/shared": "workspace:*",
    "commander": "^14.0.0",
    "jiti": "^2.7.0",
    "picocolors": "^1.1.1"
  },
  "devDependencies": {
    "@overturn-ai/api": "workspace:*",
    "@types/node": "^22.20.5",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  }
}
